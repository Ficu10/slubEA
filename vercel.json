{
  "version": 2,
  "name": "slubEA",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/zdjecia/(.*)", "dest": "/api/zdjecia/$1" },
    { "src": "/api/ping", "dest": "/api/ping.js" },
    { "src": "/api/files", "dest": "/api/files.js" },
    { "src": "/api/zdjecia", "dest": "/api/zdjecia.js" },
    { "src": "/api/upload", "dest": "/api/upload.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
